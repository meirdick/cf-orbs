{
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "files": {
    "includes": [
      "worker/**",
      "cli/**",
      "dispatch/**",
      "bench/**",
      "!bench/results",
      "!**/node_modules",
      "!**/dist",
      "!**/.wrangler",
      "!**/*.md"
    ]
  },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 110 },
  "linter": { "rules": { "preset": "recommended", "suspicious": { "noExplicitAny": "off" } } },
  "overrides": [
    {
      "includes": ["**/test/**"],
      "linter": { "rules": { "style": { "noNonNullAssertion": "off" } } }
    }
  ]
}
