// cf-orbs Worker. `cf-orbs deploy` regenerates this file from cf-orbs.config.jsonc (D16).
// durable_object scheduling: instance size is chosen at start() time, not here. Do not add
// image, instance_type, max_instances, rollout or constraints fields: wrangler rejects them for this policy.
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "cf-orbs",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-30",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "containers": [
    {
      "class_name": "OrbSession",
      "scheduling_policy": "durable_object",
      "images": { "orb": { "dockerfile": "../image/Dockerfile" } }
    },
    {
      "class_name": "ProviderHost",
      "scheduling_policy": "durable_object",
      "images": { "provider": { "dockerfile": "../provider/Dockerfile", "build_context": ".." } }
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "ORB", "class_name": "OrbSession" },
      { "name": "REGISTRY", "class_name": "Registry" },
      { "name": "PROVIDER", "class_name": "ProviderHost" }
    ]
  },
  "exports": {
    "OrbSession": { "type": "durable-object", "storage": "sqlite" },
    "Registry": { "type": "durable-object", "storage": "sqlite" },
    "ProviderHost": { "type": "durable-object", "storage": "sqlite" }
  },
  // Restarts a stopped provider container (D18).
  "triggers": { "crons": ["*/5 * * * *"] },
  "vars": {
    // ProviderConfig as a JSON string (core/config.ts). Missing fields take defaults.
    "CF_ORBS_CONFIG": "{\"instance\":{\"vcpu\":4,\"memoryMib\":12288,\"diskMb\":20000},\"maxRunning\":20,\"maxAwakeHours\":12,\"checkpointMinutes\":0,\"inactivityTimeoutMinutes\":15,\"alarmSeconds\":60,\"images\":{}}"
  }
  // Secrets (wrangler secret put / --secrets-file): CONTROL_TOKEN (always; bearer for the public /v1 API);
  // AMP_ORB_PROVIDER_TOKEN (cloudflare provider mode only).
}
